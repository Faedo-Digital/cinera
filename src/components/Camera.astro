---
import { Image } from "astro:assets";
import logoFaedoDigital from "@assets/logo-faedo-digital.webp";
import heroFallbackVideo from "@assets/hero.mp4";

interface Props {
  /** `page`: embed en /directo. `hero`: fondo a pantalla completa en la home. */
  mode?: "page" | "hero";
  loadingText?: string;
  /** Retrasa el arranque del stream para no competir con el LCP. */
  deferred?: boolean;
}

const {
  mode = "page",
  loadingText = "Conectando con la cámara…",
  deferred = false,
} = Astro.props;

const isHero = mode === "hero";
---

<div
  id="camara-wrapper"
  class:list={["camara-wrapper", isHero && "camara-wrapper--hero"]}
  data-mode={mode}
  data-deferred={deferred ? "1" : "0"}
  data-camara-estado="cargando"
>
  <!-- Estado: cargando -->
  <div id="estado-cargando" class="camara-estado estado-cargando">
    <Image
      src={logoFaedoDigital}
      alt="Faedo Digital"
      width={180}
      height={45}
      class="logo-cargando"
      loading={isHero ? "lazy" : "eager"}
    />
    <span class="spinner" aria-hidden="true"></span>
    <p id="texto-cargando">{loadingText}</p>
    <p id="progreso-cargando" class="progreso-cargando" aria-live="polite"></p>
  </div>

  <!-- Estado: error (solo modo page) -->
  {
    !isHero && (
      <div id="estado-error" class="camara-estado oculto">
        <p class="error-icono">📡</p>
        <p id="texto-error">La cámara no está disponible en este momento.</p>
        <button id="btn-reintentar" type="button">Reintentar</button>
      </div>
    )
  }

  <!-- Estado: navegador no compatible (solo modo page) -->
  {
    !isHero && (
      <div id="estado-no-soportado" class="camara-estado oculto">
        <p class="error-icono">⚠️</p>
        <p id="texto-no-soportado">
          Tu navegador no puede reproducir este directo (requiere H.265/HEVC).
          Prueba Safari o Chrome reciente en un dispositivo compatible, o vuelve
          más tarde cuando haya una versión adaptativa.
        </p>
      </div>
    )
  }

  <!-- Fallback hero: vídeo del Faedo si el stream falla -->
  {
    isHero && (
      <video
        id="camara-fallback"
        class="oculto"
        playsinline
        muted
        loop
        aria-label="Vídeo de Ciñera"
      >
        <source src={heroFallbackVideo} type="video/mp4" />
      </video>
    )
  }

  <video
    id="camara-vivo"
    autoplay
    muted
    playsinline
    webkit-playsinline
    class="oculto"></video>

  {
    isHero && (
      <div
        id="indicador-directo"
        class="indicador-directo oculto"
        aria-live="polite"
      >
        <span class="indicador-directo-punto" aria-hidden="true"></span>
        <span>En directo</span>
      </div>
    )
  }

  {
    !isHero && (
      <div id="selector-calidad" class="selector-calidad oculto" role="group" aria-label="Calidad del directo">
        <button
          type="button"
          id="btn-calidad-sd"
          class="btn-calidad"
          data-calidad="sd"
          aria-pressed="true"
        >
          Estándar
        </button>
        <button
          type="button"
          id="btn-calidad-hd"
          class="btn-calidad oculto"
          data-calidad="hd"
          aria-pressed="false"
        >
          Alta calidad (4K)
          <span class="badge-hd oculto" aria-hidden="true">HD</span>
        </button>
      </div>
    )
  }

  {
    !isHero && (
      <button
        type="button"
        id="btn-fullscreen"
        class="btn-fullscreen oculto"
        aria-label="Pantalla completa"
        aria-pressed="false"
      >
        <span class="icono-fs-expandir" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
            ></path></svg
          >
        </span>
        <span class="icono-fs-contraer oculto" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"
            ></path></svg
          >
        </span>
      </button>
    )
  }
</div>

{
  !isHero && (
    <details id="debug-panel" class="debug-panel oculto" open>
      <summary>Diagnóstico de reproducción</summary>
      <div id="debug-info" class="debug-info"></div>
      <pre id="debug-log" class="debug-log"></pre>
    </details>
  )
}

<script>
  import Hls from "hls.js";
  import {
    CAMERA_SD_CODECS,
    CAMERA_STREAM_URL,
    DEFERRED_IDLE_TIMEOUT_MS,
    DELAY_REINTENTO_MS,
    MAX_REINTENTOS,
    TIMEOUT_CARGA_MS,
    TIMEOUT_PRIMER_FRAME_MS,
    browserSupportsHevc,
    choosePlaybackPathForKnownStream,
    classifyHlsError,
    codecsForCalidad,
    formatDebugInfo,
    mseSupportsCodecs,
    nativeSupportsCodecs,
    nextRetryDelayMs,
    readStoredCalidad,
    resolveCalidadInicial,
    shouldRetryError,
    streamUrlForCalidad,
    umamiTrack,
    writeStoredCalidad,
    type CalidadCamara,
    type CamaraAnalyticsPayload,
    type ErrorCamaraTipo,
    type EstadoUi,
    type PlaybackPath,
  } from "../lib/cameraStream";

  type CameraController = {
    wrapper: HTMLElement;
    destroy: () => void;
  };

  let active: CameraController | null = null;

  function createCamera(wrapper: HTMLElement): CameraController {
    const videoEl = wrapper.querySelector("#camara-vivo");
    if (!(videoEl instanceof HTMLVideoElement)) {
      return { wrapper, destroy: () => {} };
    }
    const video = videoEl;

    const elCargando = wrapper.querySelector("#estado-cargando");
    const elError = wrapper.querySelector("#estado-error");
    const elNoSoportado = wrapper.querySelector("#estado-no-soportado");
    const elFallback = wrapper.querySelector(
      "#camara-fallback",
    ) as HTMLVideoElement | null;
    const elIndicadorDirecto = wrapper.querySelector("#indicador-directo");
    const elProgreso = wrapper.querySelector(
      "#progreso-cargando",
    ) as HTMLElement | null;
    const elTextoError = wrapper.querySelector(
      "#texto-error",
    ) as HTMLElement | null;
    const btnReintentar = wrapper.querySelector(
      "#btn-reintentar",
    ) as HTMLButtonElement | null;
    const btnFullscreen = wrapper.querySelector(
      "#btn-fullscreen",
    ) as HTMLButtonElement | null;
    const iconoExpandir = btnFullscreen?.querySelector(".icono-fs-expandir");
    const iconoContraer = btnFullscreen?.querySelector(".icono-fs-contraer");
    const selectorCalidad = wrapper.querySelector("#selector-calidad");
    const btnCalidadSd = wrapper.querySelector(
      "#btn-calidad-sd",
    ) as HTMLButtonElement | null;
    const btnCalidadHd = wrapper.querySelector(
      "#btn-calidad-hd",
    ) as HTMLButtonElement | null;
    const badgeHd = btnCalidadHd?.querySelector(".badge-hd");

    const isHero = wrapper.dataset.mode === "hero";
    const deferred = wrapper.dataset.deferred === "1";
    const mode = isHero ? "hero" : "page";

    const isTypeSupportedProbe = window.MediaSource?.isTypeSupported?.bind(
      window.MediaSource,
    );
    const hdDisponible =
      !isHero &&
      browserSupportsHevc({
        isTypeSupported: isTypeSupportedProbe,
        canPlayType: video.canPlayType.bind(video),
        userAgent: navigator.userAgent,
      });
    let calidadActual: CalidadCamara = isHero
      ? "sd"
      : resolveCalidadInicial(hdDisponible, readStoredCalidad());

    let streamUrl = isHero
      ? CAMERA_STREAM_URL
      : streamUrlForCalidad(calidadActual);

    let sessionId = 0;
    let reintentos = 0;
    let hls: Hls | null = null;
    let timeoutReintento: number | null = null;
    let timeoutCarga: number | null = null;
    let timeoutPrimerFrame: number | null = null;
    let idleCallbackId: number | null = null;
    let deferredTimer: number | null = null;
    let estadoActual: EstadoUi = "cargando";
    let playbackPath: PlaybackPath = "none";
    let startedAt = 0;
    let ultimoError: ErrorCamaraTipo = "unknown";
    let ultimaCausa = "";
    let destroyed = false;

    const params = new URLSearchParams(window.location.search);
    const debugEnabled = params.get("debugCam") === "1";
    const debugLog = document.getElementById("debug-log");
    const debugInfo = document.getElementById("debug-info");
    const debugPanel = document.getElementById("debug-panel");
    const MAX_LOGS = 40;
    const logs: string[] = [];

    if (debugPanel && debugEnabled && !isHero) {
      debugPanel.classList.remove("oculto");
    }

    let mediaAbort = new AbortController();

    function resetMediaListeners() {
      mediaAbort.abort();
      mediaAbort = new AbortController();
    }

    function logDebug(message: string) {
      if (!debugEnabled) return;
      const stamp = new Date().toLocaleTimeString("es-ES", {
        hour12: false,
        timeZone: "Europe/Madrid",
      });
      logs.unshift(`[${stamp}] ${message}`);
      if (logs.length > MAX_LOGS) logs.length = MAX_LOGS;
      if (debugLog) debugLog.textContent = logs.join("\n");
    }

    function track(
      event:
        | "cam_ready"
        | "cam_error"
        | "cam_fallback"
        | "cam_unsupported"
        | "cam_quality_change",
      extra: Partial<CamaraAnalyticsPayload> = {},
    ) {
      umamiTrack(event, {
        mode,
        route: window.location.pathname,
        path: playbackPath,
        reintentos,
        calidad: calidadActual,
        ...extra,
      });
    }

    function syncCalidadUi() {
      if (!selectorCalidad || isHero) return;

      btnCalidadHd?.classList.toggle("oculto", !hdDisponible);

      const visible = estadoActual === "video" && hdDisponible;
      selectorCalidad.classList.toggle("oculto", !visible);

      btnCalidadSd?.classList.toggle("activo", calidadActual === "sd");
      btnCalidadHd?.classList.toggle("activo", calidadActual === "hd");
      btnCalidadSd?.setAttribute(
        "aria-pressed",
        calidadActual === "sd" ? "true" : "false",
      );
      btnCalidadHd?.setAttribute(
        "aria-pressed",
        calidadActual === "hd" ? "true" : "false",
      );
      badgeHd?.classList.toggle("oculto", calidadActual !== "hd");
    }

    function cambiarCalidad(nueva: CalidadCamara) {
      if (isHero || nueva === calidadActual) return;
      if (nueva === "hd" && !hdDisponible) return;

      logDebug(`calidad -> ${nueva}`);
      calidadActual = nueva;
      streamUrl = streamUrlForCalidad(calidadActual);
      writeStoredCalidad(calidadActual);
      track("cam_quality_change", { calidad: nueva });
      onReintentar();
    }

    function onCalidadSdClick() {
      cambiarCalidad("sd");
    }

    function onCalidadHdClick() {
      cambiarCalidad("hd");
    }

    function setProgreso(texto: string) {
      if (elProgreso) elProgreso.textContent = texto;
    }

    function emitEstado(estado: EstadoUi) {
      wrapper.dataset.camaraEstado = estado;
      wrapper.dispatchEvent(
        new CustomEvent("camara:estado", {
          detail: { estado, mode, causa: ultimaCausa, tipo: ultimoError },
          bubbles: true,
        }),
      );
    }

    function renderInfo(extra = "") {
      if (!debugEnabled || !debugInfo) return;
      const isTypeSupported = window.MediaSource?.isTypeSupported?.bind(
        window.MediaSource,
      );
      const nativeHls =
        video.canPlayType("application/vnd.apple.mpegurl") || "no";
      const codecsActuales = isHero
        ? CAMERA_SD_CODECS
        : codecsForCalidad(calidadActual);
      debugInfo.textContent = formatDebugInfo({
        UA: navigator.userAgent,
        MSE: typeof window.MediaSource !== "undefined" ? "si" : "no",
        "hls.js": Hls.isSupported() ? "si" : "no",
        "HLS nativo": nativeHls,
        "HD disponible": hdDisponible ? "si" : "no",
        calidad: calidadActual,
        "MSE códec": mseSupportsCodecs(codecsActuales, isTypeSupported)
          ? "si"
          : "no",
        "native códec": nativeSupportsCodecs(
          codecsActuales,
          video.canPlayType.bind(video),
        )
          ? "si"
          : "no",
        stream: streamUrl,
        codecs: codecsActuales,
        path: playbackPath,
        reintentos: `${reintentos}/${MAX_REINTENTOS}`,
        mode,
        session: sessionId,
        estado_actual: estadoActual,
        ultimo_error: ultimaCausa || "—",
        ...(extra ? { extra } : {}),
      });
    }

    function fullscreenElementActual(): Element | null {
      return (
        document.fullscreenElement ??
        (document as Document & { webkitFullscreenElement?: Element | null })
          .webkitFullscreenElement ??
        null
      );
    }

    function syncUiFullscreen() {
      if (!btnFullscreen || !iconoExpandir || !iconoContraer) return;
      const fs = fullscreenElementActual();
      const activo = fs === wrapper || fs === video;
      btnFullscreen.setAttribute("aria-pressed", activo ? "true" : "false");
      btnFullscreen.setAttribute(
        "aria-label",
        activo ? "Salir de pantalla completa" : "Pantalla completa",
      );
      iconoExpandir.classList.toggle("oculto", activo);
      iconoContraer.classList.toggle("oculto", !activo);
    }

    async function salirFullscreen() {
      const doc = document as Document & {
        webkitExitFullscreen?: () => void;
      };
      if (document.exitFullscreen) {
        await document.exitFullscreen().catch(() => {});
      } else if (doc.webkitExitFullscreen) {
        doc.webkitExitFullscreen();
      }
    }

    async function entrarFullscreen() {
      const v = video as HTMLVideoElement & {
        webkitEnterFullscreen?: () => void;
      };

      const intentar = async (el: HTMLElement) => {
        if (el.requestFullscreen) {
          await el.requestFullscreen();
          return;
        }
        const webkit = (
          el as HTMLElement & { webkitRequestFullscreen?: () => void }
        ).webkitRequestFullscreen;
        if (webkit) {
          webkit.call(el);
          return;
        }
        throw new Error("sin fullscreen");
      };

      try {
        await intentar(wrapper);
      } catch {
        try {
          await intentar(video);
        } catch {
          if (v.webkitEnterFullscreen) {
            v.webkitEnterFullscreen();
          }
        }
      }
    }

    async function toggleFullscreen() {
      if (fullscreenElementActual()) {
        await salirFullscreen();
      } else {
        await entrarFullscreen();
      }
    }

    function onFullscreenClick() {
      toggleFullscreen().catch((err) => {
        logDebug(
          `fullscreen falló: ${err instanceof Error ? err.message : String(err)}`,
        );
      });
    }

    function mostrar(estado: EstadoUi) {
      estadoActual = estado;
      elCargando?.classList.toggle("oculto", estado !== "cargando");
      elError?.classList.toggle("oculto", estado !== "error");
      elNoSoportado?.classList.toggle("oculto", estado !== "no-soportado");
      video.classList.toggle("oculto", estado !== "video");
      elFallback?.classList.toggle("oculto", estado !== "fallback");
      elIndicadorDirecto?.classList.toggle("oculto", estado !== "video");
      btnFullscreen?.classList.toggle("oculto", estado !== "video");
      syncCalidadUi();

      if (estado === "fallback" && elFallback) {
        elFallback.play().catch(() => {});
      }

      if (estado !== "video") {
        if (fullscreenElementActual()) {
          salirFullscreen().catch(() => {});
        }
        syncUiFullscreen();
      }

      emitEstado(estado);
      logDebug(`estado UI -> ${estado}`);
      renderInfo();
    }

    function cancelarTimeoutCarga() {
      if (timeoutCarga) {
        clearTimeout(timeoutCarga);
        timeoutCarga = null;
      }
    }

    function cancelarTimeoutPrimerFrame() {
      if (timeoutPrimerFrame) {
        clearTimeout(timeoutPrimerFrame);
        timeoutPrimerFrame = null;
      }
    }

    function resetVideoElement() {
      try {
        video.pause();
      } catch {
        // ignore
      }
      video.removeAttribute("src");
      video.load();
    }

    function destruirHls() {
      if (hls) {
        logDebug("destruyendo instancia hls.js");
        hls.destroy();
        hls = null;
      }
      if (timeoutReintento) {
        clearTimeout(timeoutReintento);
        timeoutReintento = null;
      }
      cancelarTimeoutCarga();
      cancelarTimeoutPrimerFrame();
      resetMediaListeners();
    }

    function fallarDefinitivo(tipo: ErrorCamaraTipo, details: string) {
      ultimoError = tipo;
      ultimaCausa = details;
      const ms = startedAt ? Date.now() - startedAt : undefined;

      if (isHero) {
        logDebug(`hero: fallback (${tipo}) ${details}`);
        track("cam_fallback", { type: tipo, details, ms });
        mostrar("fallback");
        return;
      }

      if (tipo === "unsupported" || tipo === "codec") {
        logDebug(`no soportado: ${details}`);
        track("cam_unsupported", { type: tipo, details, ms });
        if (calidadActual === "hd" && !isHero) {
          calidadActual = "sd";
          streamUrl = streamUrlForCalidad("sd");
          writeStoredCalidad("sd");
        }
        mostrar("no-soportado");
        return;
      }

      if (elTextoError) {
        elTextoError.textContent =
          tipo === "timeout"
            ? "La cámara tarda demasiado en responder. Comprueba tu conexión e inténtalo de nuevo."
            : "La cámara no está disponible en este momento.";
      }
      logDebug(`error definitivo: ${tipo} / ${details}`);
      track("cam_error", { type: tipo, details, ms });
      mostrar("error");
    }

    function onError(tipo: ErrorCamaraTipo, details: string, session: number) {
      if (destroyed || session !== sessionId) return;
      ultimoError = tipo;
      ultimaCausa = details;
      logDebug(`error -> ${tipo}: ${details}`);
      renderInfo();
      destruirHls();
      resetVideoElement();

      if (shouldRetryError(tipo, reintentos, MAX_REINTENTOS)) {
        reintentos++;
        const delay = nextRetryDelayMs(reintentos, DELAY_REINTENTO_MS);
        setProgreso(`Reintentando… (${reintentos}/${MAX_REINTENTOS})`);
        logDebug(`reintento en ${delay}ms (${reintentos}/${MAX_REINTENTOS})`);
        timeoutReintento = window.setTimeout(() => {
          if (!destroyed && sessionId === session) {
            iniciarStream();
          }
        }, delay);
        return;
      }

      fallarDefinitivo(tipo, details);
    }

    async function marcarListo(session: number) {
      if (destroyed || session !== sessionId) return;
      cancelarTimeoutCarga();
      setProgreso("Arrancando reproducción…");

      try {
        await video.play();
      } catch (err) {
        const name = err instanceof Error ? err.name : "Error";
        const message = err instanceof Error ? err.message : String(err);
        logDebug(`play() rechazado: ${name} ${message}`);
        if (name === "NotAllowedError") {
          // Muted autoplay debería funcionar; si no, mostramos el vídeo igual.
          logDebug("autoplay bloqueado; se muestra el vídeo en pausa");
        } else if (name !== "AbortError") {
          onError("play", `${name}: ${message}`, session);
          return;
        }
      }

      if (destroyed || session !== sessionId) return;

      const confirmar = () => {
        if (destroyed || session !== sessionId) return;
        if (estadoActual === "video") return;
        cancelarTimeoutPrimerFrame();
        const ms = Date.now() - startedAt;
        reintentos = 0;
        setProgreso("");
        mostrar("video");
        track("cam_ready", { ms });
        logDebug(`listo en ${ms}ms vía ${playbackPath}`);
      };

      if (!video.paused && video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        confirmar();
        return;
      }

      const onPlaying = () => confirmar();
      const onLoaded = () => {
        if (!video.paused) confirmar();
      };
      video.addEventListener("playing", onPlaying, {
        once: true,
        signal: mediaAbort.signal,
      });
      video.addEventListener("loadeddata", onLoaded, {
        once: true,
        signal: mediaAbort.signal,
      });

      cancelarTimeoutPrimerFrame();
      timeoutPrimerFrame = window.setTimeout(() => {
        if (destroyed || session !== sessionId || estadoActual === "video") {
          return;
        }
        // Si hay datos aunque no haya disparado playing, mostramos.
        if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
          confirmar();
          return;
        }
        onError(
          "timeout",
          `sin primer frame en ${TIMEOUT_PRIMER_FRAME_MS}ms`,
          session,
        );
      }, TIMEOUT_PRIMER_FRAME_MS);
    }

    function iniciarStream() {
      if (destroyed) return;
      destruirHls();
      resetVideoElement();

      sessionId += 1;
      const session = sessionId;
      if (!startedAt) startedAt = Date.now();

      wrapper.classList.remove("camara-wrapper--deferred");
      mostrar("cargando");
      setProgreso(
        reintentos > 0
          ? `Conectando… intento ${reintentos + 1}`
          : "Obteniendo señal…",
      );
      renderInfo();
      logDebug(`iniciando stream session=${session} calidad=${calidadActual}`);

      const isTypeSupported = window.MediaSource?.isTypeSupported?.bind(
        window.MediaSource,
      );
      const codecsActuales = isHero
        ? CAMERA_SD_CODECS
        : codecsForCalidad(calidadActual);
      playbackPath = choosePlaybackPathForKnownStream({
        hlsJsSupported: Hls.isSupported(),
        nativeHls: !!video.canPlayType("application/vnd.apple.mpegurl"),
        isTypeSupported,
        canPlayType: video.canPlayType.bind(video),
        codecs: codecsActuales,
      });
      logDebug(`ruta elegida: ${playbackPath}`);
      renderInfo();

      if (playbackPath === "none") {
        onError(
          "unsupported",
          `sin soporte para ${codecsActuales}`,
          session,
        );
        return;
      }

      timeoutCarga = window.setTimeout(() => {
        if (destroyed || session !== sessionId) return;
        if (estadoActual === "cargando") {
          onError("timeout", `timeout de carga (${TIMEOUT_CARGA_MS}ms)`, session);
        }
      }, TIMEOUT_CARGA_MS);

      if (playbackPath === "hlsjs") {
        setProgreso("Cargando manifiesto HLS…");
        hls = new Hls({
          lowLatencyMode: true,
          backBufferLength: 30,
          maxBufferLength: 20,
          enableWorker: true,
        });

        hls.loadSource(streamUrl);
        hls.attachMedia(video);

        hls.on(Hls.Events.MANIFEST_PARSED, () => {
          if (session !== sessionId) return;
          logDebug("manifest parseado");
          setProgreso("Manifiesto listo, esperando vídeo…");
          void marcarListo(session);
        });

        hls.on(Hls.Events.ERROR, (_event, data) => {
          if (session !== sessionId) return;
          const details = `${data.type} / ${data.details} / fatal=${data.fatal ? "si" : "no"}`;
          logDebug(`hls.js error -> ${details}`);
          renderInfo(details);
          if (!data.fatal) return;
          const tipo = classifyHlsError(data);
          onError(tipo, details, session);
        });
        return;
      }

      // Ruta HLS nativa (Safari/iOS)
      setProgreso("Cargando stream nativo…");
      video.src = streamUrl;
      video.load();

      video.addEventListener(
        "canplay",
        () => {
          if (session !== sessionId) return;
          logDebug("canplay nativo");
          void marcarListo(session);
        },
        { once: true, signal: mediaAbort.signal },
      );

      video.addEventListener(
        "error",
        () => {
          if (session !== sessionId) return;
          const mediaError = video.error;
          const details = mediaError
            ? `code=${mediaError.code}, message=${mediaError.message || "sin mensaje"}`
            : "error nativo sin detalle";
          logDebug(`video error nativo -> ${details}`);
          onError(
            mediaError?.code === MediaError.MEDIA_ERR_SRC_NOT_SUPPORTED
              ? "codec"
              : "media",
            details,
            session,
          );
        },
        { once: true, signal: mediaAbort.signal },
      );
    }

    function onReintentar() {
      logDebug("click en reintentar");
      reintentos = 0;
      startedAt = Date.now();
      ultimoError = "unknown";
      ultimaCausa = "";
      iniciarStream();
    }

    btnFullscreen?.addEventListener("click", onFullscreenClick);
    btnReintentar?.addEventListener("click", onReintentar);
    btnCalidadSd?.addEventListener("click", onCalidadSdClick);
    btnCalidadHd?.addEventListener("click", onCalidadHdClick);
    document.addEventListener("fullscreenchange", syncUiFullscreen);
    document.addEventListener(
      "webkitfullscreenchange",
      syncUiFullscreen as EventListener,
    );

    renderInfo("esperando inicio");

    if (deferred) {
      wrapper.classList.add("camara-wrapper--deferred");
      setProgreso("Esperando para no bloquear la carga de la página…");
      const kickoff = () => {
        idleCallbackId = null;
        deferredTimer = null;
        if (!destroyed) iniciarStream();
      };
      const ric = (
        window as Window & {
          requestIdleCallback?: (
            cb: IdleRequestCallback,
            opts?: IdleRequestOptions,
          ) => number;
          cancelIdleCallback?: (id: number) => void;
        }
      ).requestIdleCallback;
      if (ric) {
        idleCallbackId = ric(kickoff, { timeout: DEFERRED_IDLE_TIMEOUT_MS });
      } else {
        deferredTimer = window.setTimeout(kickoff, 1);
      }
    } else {
      iniciarStream();
    }

    return {
      wrapper,
      destroy() {
        if (destroyed) return;
        destroyed = true;
        sessionId += 1;
        logDebug("destroy controller");
        destruirHls();
        resetVideoElement();

        if (idleCallbackId != null) {
          (
            window as Window & { cancelIdleCallback?: (id: number) => void }
          ).cancelIdleCallback?.(idleCallbackId);
          idleCallbackId = null;
        }
        if (deferredTimer) {
          clearTimeout(deferredTimer);
          deferredTimer = null;
        }

        btnFullscreen?.removeEventListener("click", onFullscreenClick);
        btnReintentar?.removeEventListener("click", onReintentar);
        btnCalidadSd?.removeEventListener("click", onCalidadSdClick);
        btnCalidadHd?.removeEventListener("click", onCalidadHdClick);
        document.removeEventListener("fullscreenchange", syncUiFullscreen);
        document.removeEventListener(
          "webkitfullscreenchange",
          syncUiFullscreen as EventListener,
        );

        if (elFallback) {
          try {
            elFallback.pause();
          } catch {
            // ignore
          }
        }
      },
    };
  }

  function mountCamera() {
    const wrapper = document.getElementById("camara-wrapper");
    if (!wrapper) {
      active?.destroy();
      active = null;
      return;
    }
    if (active?.wrapper === wrapper) return;
    active?.destroy();
    active = createCamera(wrapper);
  }

  function unmountCamera() {
    active?.destroy();
    active = null;
  }

  document.addEventListener("astro:page-load", mountCamera);
  document.addEventListener("astro:before-swap", unmountCamera);

  // Primera carga (sin esperar al evento si el DOM ya está listo).
  if (document.getElementById("camara-wrapper")) {
    mountCamera();
  }
</script>

