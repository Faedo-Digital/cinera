---
import { Image } from "astro:assets";
import heroPlaceholder from "../assets/faedo-de-cinera.webp";
import Button from "./Button.astro";
import Camera from "./Camera.astro";
---

<section
  class="relative min-h-[500px] md:min-h-[600px] flex items-center justify-center overflow-hidden"
>
  <div class="absolute inset-0 z-0">
    <!-- Imagen estática: LCP y fondo hasta que arranque el stream -->
    <Image
      src={heroPlaceholder}
      alt="Vista de Ciñera"
      class="absolute inset-0 w-full h-full object-cover"
      widths={[768, 1024, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Webcam en directo (diferida); si falla, usa el vídeo del Faedo -->
    <Camera
      mode="hero"
      deferred
      loadingText="Conectando con Ciñera en directo…"
    />

    <div class="absolute inset-0 bg-black/30 z-20 pointer-events-none"></div>
  </div>

  <div class="relative z-30 container text-center px-4 py-16">
    <h1
      class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight drop-shadow-lg"
    >
      Ciñera, sólo hay una
    </h1>
    <p
      class="mt-4 text-lg md:text-xl text-white/95 max-w-2xl mx-auto drop-shadow-md"
    >
      Descubre todos los secretos de este hermoso pueblo de la montaña central
      de León.
    </p>
    <div class="mt-8">
      <Button
        href="/directo"
        text="Ver Ciñera en directo"
        title="Ver Ciñera en directo"
        target="_self"
        rel=""
      />
    </div>
  </div>
</section>
