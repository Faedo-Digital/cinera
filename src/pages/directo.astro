---
import Layout from "@components/Layout.astro";
import Prose from "@components/Prose.astro";
import SectionHeader from "@components/SectionHeader.astro";
import Camera from "@components/Camera.astro";
import Weather from "@/components/Weather.astro";
---

<Layout
  title="Webcam en directo de Ciñera · León"
  description="Cámara en directo de Ciñera, en el valle de Gordón. Vista del pueblo desde la calle El Otero, en la Montaña Central Leonesa."
>
  <section class="container py-12 md:py-16">
    <SectionHeader
      title="Webcam en directo"
      description="Ciñera, ahora mismo. El pueblo visto desde la calle El Otero."
    />

    <div class="max-w-4xl mx-auto mt-8 space-y-4">
      <!-- Indicador de directo + reloj (sincronizado con el estado real de la cámara) -->
      <div class="flex items-center justify-between text-sm text-slate-500">
        <div
          id="badge-directo"
          class="flex items-center gap-2"
          data-estado="cargando"
        >
          <span
            id="badge-directo-punto"
            class="inline-block w-2 h-2 rounded-full bg-amber-500 animate-pulse"
            aria-hidden="true"
          ></span>
          <span id="badge-directo-texto" class="font-medium text-slate-700"
            >Conectando…</span
          >
        </div>
        <time id="reloj" datetime="" class="tabular-nums"></time>
      </div>

      <!-- Componente de cámara -->
      <Camera />

      <!-- Contexto bajo la cámara -->
      <p class="text-sm text-slate-500 text-center">
        Cámara ubicada en la <strong>calle El Otero</strong> · Ciñera · Valle de Gordón
        · León
      </p>

      <Weather />
    </div>

    <!-- Contenido SEO y contexto -->
    <Prose class="max-w-3xl mt-12">
      <h2>Qué estás viendo</h2>
      <p>
        Esta cámara ofrece una vista en tiempo real de <strong>Ciñera</strong>
        desde la calle El Otero, mostrando el núcleo del pueblo enclavado en el valle
        de Gordón, en plena Montaña Central Leonesa.
      </p>
      <p>
        Desde este ángulo puedes ver cómo cambia el pueblo con las estaciones:
        la nieve cubriendo los tejados en invierno, la luz dorada del otoño
        sobre las laderas, o los días largos y claros del verano en la montaña.
      </p>
      <h2>Ciñera, un pueblo con historia</h2>
      <p>
        Lo que muestra la cámara es un pueblo que vivió décadas de intensa
        actividad minera. Las viviendas que se ven —los antiguos
        <em>cuarteles</em> construidos por la <strong
          >Hullera Vasco-Leonesa</strong
        >
        para los mineros y sus familias— son parte del patrimonio arquitectónico de
        la cuenca minera leonesa.
      </p>
      <p>
        Hoy Ciñera es también la puerta de entrada al
        <a href="https://faedo.es" target="_blank" rel="noopener noreferrer"
          ><strong>Faedo de Ciñera</strong></a
        >, el hayedo premiado como bosque mejor cuidado de España en 2007, y
        punto de partida del Camino del Carbón.
      </p>
    </Prose>
  </section>
</Layout>

<script>
  type BadgeEstado = "cargando" | "video" | "error" | "no-soportado" | "fallback";

  type DirectoUi = {
    destroy: () => void;
  };

  let activo: DirectoUi | null = null;

  function syncBadge(estado: BadgeEstado) {
    const badge = document.getElementById("badge-directo");
    const punto = document.getElementById("badge-directo-punto");
    const texto = document.getElementById("badge-directo-texto");
    if (!badge || !punto || !texto) return;

    badge.dataset.estado = estado;
    punto.classList.remove("bg-red-500", "bg-amber-500", "bg-slate-400");

    switch (estado) {
      case "video":
        punto.classList.add("bg-red-500", "animate-pulse");
        texto.textContent = "En directo";
        break;
      case "cargando":
        punto.classList.add("bg-amber-500", "animate-pulse");
        texto.textContent = "Conectando…";
        break;
      case "no-soportado":
        punto.classList.remove("animate-pulse");
        punto.classList.add("bg-slate-400");
        texto.textContent = "No compatible";
        break;
      case "error":
      case "fallback":
      default:
        punto.classList.remove("animate-pulse");
        punto.classList.add("bg-slate-400");
        texto.textContent = "Sin señal";
        break;
    }
  }

  function mountDirecto() {
    const reloj = document.getElementById("reloj");
    const camara = document.getElementById("camara-wrapper");
    if (!reloj && !camara) return;

    activo?.destroy();

    function actualizarReloj() {
      const el = document.getElementById("reloj");
      if (!el) return;

      const ahora = new Date();
      const opciones: Intl.DateTimeFormatOptions = {
        weekday: "long",
        day: "numeric",
        month: "long",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        timeZone: "Europe/Madrid",
      };

      el.textContent = ahora.toLocaleString("es-ES", opciones);
      el.setAttribute("datetime", ahora.toISOString());
    }

    actualizarReloj();
    const intervalId = window.setInterval(actualizarReloj, 1000);

    const onEstado = (event: Event) => {
      const detail = (event as CustomEvent<{ estado?: BadgeEstado }>).detail;
      if (detail?.estado) syncBadge(detail.estado);
    };

    camara?.addEventListener("camara:estado", onEstado);
    const inicial = camara?.dataset.camaraEstado as BadgeEstado | undefined;
    syncBadge(inicial ?? "cargando");

    activo = {
      destroy() {
        clearInterval(intervalId);
        camara?.removeEventListener("camara:estado", onEstado);
      },
    };
  }

  function unmountDirecto() {
    activo?.destroy();
    activo = null;
  }

  document.addEventListener("astro:page-load", mountDirecto);
  document.addEventListener("astro:before-swap", unmountDirecto);

  if (document.getElementById("reloj") || document.getElementById("camara-wrapper")) {
    mountDirecto();
  }
</script>
